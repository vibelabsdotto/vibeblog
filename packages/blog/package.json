{
  "name": "@vibelabsdotto/blog",
  "version": "0.1.0",
  "description": "Drop-in MDX blog for Next.js App Router sites.",
  "license": "MIT",
  "author": "VibeLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibelabsdotto/vibeblog.git",
    "directory": "packages/blog"
  },
  "homepage": "https://github.com/vibelabsdotto/vibeblog/tree/main/packages/blog#readme",
  "bugs": "https://github.com/vibelabsdotto/vibeblog/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "nextjs",
    "mdx",
    "blog",
    "app-router",
    "react-server-components"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "bin": {
    "vibeblog": "bin/vibeblog.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.1.0",
    "react-dom": ">=19.1.0"
  },
  "dependencies": {
    "@types/mdx": "^2.0.14",
    "next-mdx-remote-client": "^2.1.12",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sugar-high": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
