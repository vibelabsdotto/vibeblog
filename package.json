{
  "name": "vibeblog",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @vibelabsdotto/blog && npm run build -w example",
    "build:package": "npm run build -w @vibelabsdotto/blog",
    "dev": "npm run build:package && npm run dev -w example",
    "dev:package": "npm run dev -w @vibelabsdotto/blog",
    "typecheck": "npm run typecheck -w @vibelabsdotto/blog"
  }
}
